<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="BlockSensitiveFiles" stopProcessing="true">
          <match url="^(\.env|.*\.sql|.*\.md|.*\.bat|.*\.gs|backend(/.*)?|App_Data(/.*)?|api/(bootstrap\.php|mariadb_schema\.sql))$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>
        <rule name="ApiRoute" stopProcessing="true">
          <match url="^api/(.*)$" ignoreCase="true" />
          <action type="Rewrite" url="api/index.php?route={R:1}" appendQueryString="true" />
        </rule>
        <rule name="StripTrailingSlash" stopProcessing="true">
          <match url="^(.+)/$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="RedirectIndexHtml" stopProcessing="true">
          <match url="^index\.html$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="RedirectDotHtml" stopProcessing="true">
          <match url="^(about|services|team|careers|contact|process|privacy|admin|role-fronter|role-closer|role-verifier|service-appointments|service-final-expense|service-lead-generation|service-operations|service-quality|service-us-outbound)\.html$" ignoreCase="true" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="AdminCleanUrl" stopProcessing="true">
          <match url="^admin$" ignoreCase="true" />
          <action type="Rewrite" url="admin.html" appendQueryString="true" />
        </rule>
        <rule name="PublicCleanUrls" stopProcessing="true">
          <match url="^$|^(about|services|team|careers|contact|process|privacy|role-fronter|role-closer|role-verifier|service-appointments|service-final-expense|service-lead-generation|service-operations|service-quality|service-us-outbound)$" ignoreCase="true" />
          <action type="Rewrite" url="render.php?page={R:0}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
