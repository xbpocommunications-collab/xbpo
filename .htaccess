Options -Indexes
RewriteEngine On

# Block sensitive files and internal directories
RewriteRule ^(\.env|.*\.sql|.*\.md|.*\.bat|.*\.gs|backend(/.*)?|App_Data(/.*)?|api/(bootstrap\.php|mariadb_schema\.sql))$ - [F,L,NC]

# Route /api/* requests to PHP API router
RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]

# Strip trailing slash (except root or real directories)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Redirect legacy .html URLs to clean extensionless URLs
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[\s?] [NC]
RewriteRule ^([a-z0-9-]+)\.html$ /$1 [R=301,L]

# Clean URL for Admin Portal
RewriteRule ^admin$ admin.html [QSA,L]

# Clean URLs for all public pages via render.php
RewriteRule ^$|^(about|services|team|careers|contact|process|privacy|role-fronter|role-closer|role-verifier|service-appointments|service-final-expense|service-lead-generation|service-operations|service-quality|service-us-outbound)$ render.php?page=$0 [QSA,L]
